  },
  "dependencies": {
    "@isbatak/panda-ds": "workspace:*",
    "@isbatak/react-ui": "workspace:*",
    "@remotion/cli": "4.0.543",
    "@remotion/google-fonts": "4.0.543",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:"
  }
}
