{
  "name": "@isbatak/promo-video",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "panda",
    "studio": "panda && remotion studio",
    "render:intro": "panda && remotion render Intro out/intro.mp4",
    "still:intro": "panda && remotion still Intro out/intro.jpg --frame=60 --image-format=jpeg --jpeg-quality=85",
