{
  "name": "@isbatak/lit-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Lit custom elements styled with @isbatak/panda-ds",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/components/*/*.ts"
  ],
  "exports": {
    "./*": "./src/components/*/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@isbatak/icons": "workspace:*",
    "@isbatak/panda-ds": "workspace:*"
  },
  "peerDependencies": {
    "lit": ">=3.0.0"
  },
  "devDependencies": {
    "lit": "catalog:"
  }
}
