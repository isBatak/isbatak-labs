{
  "name": "@isbatak/panda-concentric-preset",
  "version": "0.0.0",
  "description": "Panda CSS preset for concentric border radii",
  "keywords": [
    "panda",
    "pandacss",
    "preset",
    "border-radius",
    "concentric"
  ],
  "author": "Ivica Batinic <ivicabatinic123@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isBatak/isbatak-labs/tree/main/packages/panda/concentric-preset#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isBatak/isbatak-labs.git",
    "directory": "packages/panda/concentric-preset"
  },
  "bugs": {
    "url": "https://github.com/isBatak/isbatak-labs/issues"
  },
  "type": "module",
  "main": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "@pandacss/dev": ">=1.0.0",
    "@pandacss/types": ">=1.0.0"
  },
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "@pandacss/types": "catalog:"
  }
}
