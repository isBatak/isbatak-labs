{
  "name": "@isbatak/panda-theme-analog",
  "version": "0.0.0",
  "description": "Analog dark theme for @isbatak/panda-ds",
  "keywords": [
    "panda",
    "pandacss",
    "preset",
    "theme",
    "grain",
    "daw",
    "vst"
  ],
  "author": "Ivica Batinic <ivicabatinic123@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isBatak/isbatak-labs/tree/main/packages/panda/themes/analog#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isBatak/isbatak-labs.git",
    "directory": "packages/panda/themes/analog"
  },
  "bugs": {
    "url": "https://github.com/isBatak/isbatak-labs/issues"
  },
  "type": "module",
  "main": "src/index.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "assets"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./grain.png": "./assets/grain.png",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate:grain": "node scripts/generate-grain.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./grain.png": "./assets/grain.png",
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "@pandacss/dev": ">=2.2.0",
    "@pandacss/types": ">=2.2.0"
  },
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "@pandacss/types": "catalog:"
  }
}
