{
  "name": "@isbatak/panda-turbopack",
  "version": "0.1.0",
  "description": "Turbopack loader and Next.js config wrapper for Panda CSS v2 source transforms",
  "keywords": [
    "panda",
    "pandacss",
    "turbopack",
    "nextjs",
    "loader"
  ],
  "author": "Ivica Batinic <ivicabatinic123@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isBatak/isbatak-labs/tree/main/packages/panda/turbopack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isBatak/isbatak-labs.git",
    "directory": "packages/panda/turbopack"
  },
  "bugs": {
    "url": "https://github.com/isBatak/isbatak-labs/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./loader": "./dist/loader.cjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pandacss/compiler": "catalog:",
    "@pandacss/transformer": "catalog:"
  },
  "peerDependencies": {
    "next": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "next": "16.3.6"
  }
}
