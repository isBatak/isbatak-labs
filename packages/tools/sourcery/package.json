{
  "name": "@isbatak/sourcery",
  "version": "0.0.0",
  "description": "Hold a hotkey, click any element in the page, and jump to the line of code that rendered it",
  "keywords": [
    "click-to-source",
    "inspector",
    "devtools",
    "jsx",
    "nextjs",
    "turbopack",
    "webpack"
  ],
  "author": "Ivica Batinic <ivicabatinic123@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isBatak/isbatak-labs/tree/main/packages/tools/sourcery#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isBatak/isbatak-labs.git",
    "directory": "packages/tools/sourcery"
  },
  "bugs": {
    "url": "https://github.com/isBatak/isbatak-labs/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/webpack.d.ts",
        "default": "./dist/webpack.js"
      },
      "require": {
        "types": "./dist/webpack.d.cts",
        "default": "./dist/webpack.cjs"
      }
    },
    "./turbopack": {
      "import": {
        "types": "./dist/turbopack.d.ts",
        "default": "./dist/turbopack.js"
      },
      "require": {
        "types": "./dist/turbopack.d.cts",
        "default": "./dist/turbopack.cjs"
      }
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./loader": "./dist/loader.cjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "4.1.1",
    "launch-ide": "1.4.10",
    "magic-string": "^0.30.21",
    "oxc-parser": "^0.127.0",
    "portfinder": "^1.0.38"
  },
  "peerDependencies": {
    "next": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "next": "16.3.6"
  }
}
