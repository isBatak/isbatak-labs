{
  "name": "@isbatak/ark-wheel-picker",
  "version": "0.1.0",
  "description": "Ark UI style wheel-picker components for React, Solid, Vue and Svelte",
  "keywords": [
    "ark",
    "ark-ui",
    "react",
    "solid",
    "vue",
    "svelte",
    "wheel-picker"
  ],
  "author": "Ivica Batinic <ivicabatinic123@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/isBatak/isbatak-labs/tree/main/packages/ark/wheel-picker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isBatak/isbatak-labs.git",
    "directory": "packages/ark/wheel-picker"
  },
  "bugs": {
    "url": "https://github.com/isBatak/isbatak-labs/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./react": "./src/react/index.ts",
    "./solid": {
      "types": "./src/solid/index.ts",
      "solid": "./src/solid/index.ts",
      "default": "./src/solid/index.ts"
    },
    "./vue": "./src/vue/index.ts",
    "./svelte": {
      "types": "./src/svelte/index.ts",
      "svelte": "./src/svelte/index.ts",
      "default": "./src/svelte/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && svelte-package -i src/svelte -o dist/svelte --tsconfig ./tsconfig.svelte.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.solid.json && svelte-check --tsconfig ./tsconfig.svelte.json --fail-on-warnings"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./react": {
        "import": {
          "types": "./dist/react/index.d.ts",
          "default": "./dist/react/index.js"
        },
        "require": {
          "types": "./dist/react/index.d.cts",
          "default": "./dist/react/index.cjs"
        }
      },
      "./solid": {
        "types": "./dist/solid/index.d.ts",
        "solid": "./dist/solid/index.jsx",
        "default": "./dist/solid/index.js"
      },
      "./vue": {
        "import": {
          "types": "./dist/vue/index.d.ts",
          "default": "./dist/vue/index.js"
        },
        "require": {
          "types": "./dist/vue/index.d.cts",
          "default": "./dist/vue/index.cjs"
        }
      },
      "./svelte": {
        "types": "./dist/svelte/index.d.ts",
        "svelte": "./dist/svelte/index.js",
        "default": "./dist/svelte/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@isbatak/zag-wheel-picker": "workspace:*"
  },
  "peerDependencies": {
    "@ark-ui/react": ">=5.0.0",
    "@ark-ui/solid": ">=5.0.0",
    "@ark-ui/svelte": ">=5.0.0",
    "@ark-ui/vue": ">=5.0.0",
    "@zag-js/react": ">=1.0.0",
    "@zag-js/solid": ">=1.0.0",
    "@zag-js/svelte": ">=1.0.0",
    "@zag-js/vue": ">=1.0.0",
    "react": ">=18.0.0",
    "solid-js": ">=1.6.0",
    "svelte": ">=5.20.0",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "@ark-ui/react": {
      "optional": true
    },
    "@ark-ui/solid": {
      "optional": true
    },
    "@ark-ui/svelte": {
      "optional": true
    },
    "@ark-ui/vue": {
      "optional": true
    },
    "@zag-js/react": {
      "optional": true
    },
    "@zag-js/solid": {
      "optional": true
    },
    "@zag-js/svelte": {
      "optional": true
    },
    "@zag-js/vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ark-ui/react": "5.39.2",
    "@ark-ui/solid": "5.39.2",
    "@ark-ui/svelte": "5.24.2",
    "@ark-ui/vue": "5.39.2",
    "@sveltejs/package": "^2.5.8",
    "@types/react": "catalog:",
    "@zag-js/react": "catalog:",
    "@zag-js/solid": "catalog:",
    "@zag-js/svelte": "catalog:",
    "@zag-js/vue": "catalog:",
    "esbuild-plugin-solid": "^0.6.0",
    "react": "catalog:",
    "solid-js": "^1.9.15",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "vue": "^3.5.43"
  }
}
