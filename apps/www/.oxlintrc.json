{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true
  },
  "jsPlugins": [{ "name": "pandacss-www", "specifier": "./oxlint-panda.mjs" }],
  "rules": {
    "@pandacss/prefer-token": "off",
    "@pandacss/no-invalid-token-paths": "off",
    "@pandacss/no-invalid-nesting": "off",
    "pandacss-www/prefer-token": [
      "warn",
      {
        "categories": ["colors", "spacing", "radii", "fontSizes"]
      }
    ],
    "pandacss-www/no-invalid-token-paths": "error",
    "pandacss-www/no-invalid-nesting": "error"
  },
  "overrides": [
    {
      "files": ["components/ds-demos/concentric/**"],
      "rules": {
        "pandacss-www/prefer-token": "off"
      }
    }
  ]
}
