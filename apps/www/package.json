{
  "name": "@isbatak/website",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "pnpm generate:deps && pnpm generate:docs",
    "generate:deps": "[ -n \"$TURBO_HASH\" ] || (pnpm --filter @isbatak/sourcery --filter @isbatak/panda-turbopack --filter @isbatak/panda-ds --filter @isbatak/panda-theme-analog build && pnpm --filter @isbatak/solid-ui --filter @isbatak/vue-ui --filter @isbatak/compositions codegen && pnpm --filter @isbatak/compositions build)",
    "generate:docs": "node scripts/generate-api-docs.mjs && panda-studio build --base /studio/ --out .studio && panda-studio build --config ../../packages/panda/themes/analog/panda.config.ts --base /studio/analog/ --out .studio/analog && velite build --strict",
    "api:generate": "node scripts/generate-api-docs.mjs",
    "dev": "pnpm generate && pnpm run \"/^dev:/\"",
    "dev:velite": "velite dev",
    "dev:next": "next dev --port 3000",
    "build": "pnpm generate && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:compositions": "pnpm --filter @isbatak/compositions dev",
    "studio": "panda-studio",
    "studio:analog": "panda-studio --config ../../packages/panda/themes/analog/panda.config.ts"
  },
  "dependencies": {
    "@ark-ui/react": "catalog:",
    "@internationalized/date": "3.12.3",
    "@isbatak/ark-code-preview": "workspace:*",
    "@isbatak/ark-masonry": "workspace:*",
    "@isbatak/ark-text-flip": "workspace:*",
    "@isbatak/ark-wheel-picker": "workspace:*",
    "@isbatak/compositions": "workspace:*",
    "@isbatak/icons": "workspace:*",
    "@isbatak/panda-code-preview": "workspace:*",
    "@isbatak/panda-concentric-preset": "workspace:*",
    "@isbatak/panda-ds": "workspace:*",
    "@isbatak/panda-masonry": "workspace:*",
    "@isbatak/panda-text-flip": "workspace:*",
    "@isbatak/panda-wheel-picker": "workspace:*",
    "@isbatak/react-ui": "workspace:*",
    "@isbatak/zag-masonry": "workspace:*",
    "@isbatak/zag-text-flip": "workspace:*",
    "@isbatak/zag-wheel-picker": "workspace:*",
    "@zag-js/react": "catalog:",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sugar-high": "2.5.0"
  },
  "devDependencies": {
    "@isbatak/panda-studio": "workspace:*",
    "@isbatak/panda-turbopack": "workspace:*",
    "@isbatak/sourcery": "workspace:*",
    "@pandacss/dev": "catalog:",
    "@pandacss/preset-base": "catalog:",
    "@pandacss/types": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "rehype-slug": "6.0.0",
    "velite": "0.4.0"
  }
}
