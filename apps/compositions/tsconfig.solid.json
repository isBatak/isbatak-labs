{
  "extends": "../../tsconfig.json",
  "include": ["src/examples/zag/solid", "src/examples/ark/solid", "mount/solid.tsx", "mount/env.d.ts"],
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["node"],
    "paths": {
      "styled-system/*": ["./styled-system/*"]
    },
    "tsBuildInfoFile": "node_modules/.cache/.tsbuildinfo.solid"
  }
}
