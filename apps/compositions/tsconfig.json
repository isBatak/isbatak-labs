{
  "extends": "../../tsconfig.json",
  "include": [
    "src/examples/zag/react",
    "src/examples/zag/vanilla",
    "src/examples/zag/lit",
    "src/examples/ark/react",
    "src/examples/ds/react",
    "mount/react.tsx",
    "mount/vanilla.ts",
    "mount/lit.ts",
    "mount/env.d.ts"
  ],
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
