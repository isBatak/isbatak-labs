{
  "name": "@isbatak/storybook-shared",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.js"
    },
    "./recipes": {
      "types": "./styled-system/recipes/index.d.ts",
      "default": "./styled-system/recipes/index.js"
    },
    "./panda.css": "./dist/panda.css",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "panda codegen && panda cssgen -o dist/panda.css",
    "storybook": "panda cssgen --watch -o dist/panda.css",
    "typecheck": "panda codegen && tsc --noEmit"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@isbatak/panda-ds": "workspace:*",
    "@isbatak/panda-masonry": "workspace:*",
    "@isbatak/panda-swipeable-list": "workspace:*",
    "@isbatak/panda-wheel-picker": "workspace:*",
    "@isbatak/zag-wheel-picker": "workspace:*",
    "@zag-js/date-input": "catalog:"
  },
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "@pandacss/preset-base": "catalog:"
  }
}
